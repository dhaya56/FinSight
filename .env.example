# FinSight environment variables.
#
# Copy this file to .env and set values for local development.
# .env is never committed. Do not put real credentials in this example file.
#
# Docker Compose reads .env from the repository root automatically, and the
# application reads the same file, so both use one source of truth.
#
# Variables are added here as each phase introduces a setting that consumes them.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment: development | test | production
FINSIGHT_ENV=development

# ---------------------------------------------------------------------------
# API credential (secret)
# ---------------------------------------------------------------------------
#
# Shared bearer token required on every non-health route (§28.2). At least 32
# characters, and rejected if it matches a known default.
#
# Required whenever the API serves HTTP, including the container. Leaving it unset
# does not open the API — the authenticated router returns 503 to everything — so
# the failure mode is a closed door rather than an unguarded one. The UI needs the
# same value, which is the only credential that tier holds.
#
# Generate one; do not reuse a password. From an activated prompt:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FINSIGHT_API_TOKEN=

# ---------------------------------------------------------------------------
# PostgreSQL connection (non-secret)
# ---------------------------------------------------------------------------

# Use the loopback address rather than the name "localhost". The name resolves to
# both IPv6 and IPv4, and when the database is down each address is tried in turn
# and times out separately, so an unreachable database costs
# (address families x connect timeout) instead of one timeout. Compose publishes
# the service on IPv4 loopback only. Measured in ENV-002.
FINSIGHT_POSTGRES_HOST=127.0.0.1
FINSIGHT_POSTGRES_PORT=5432
FINSIGHT_POSTGRES_DB=finsight
FINSIGHT_POSTGRES_USER=finsight

# ---------------------------------------------------------------------------
# PostgreSQL credential (secret)
# ---------------------------------------------------------------------------

# Required. Leave empty here and set a real value only in .env.
#
# Rejected at startup when empty or when it matches a known default value:
# postgres, password, changeme, secret, admin, example, finsight.
# Rejection guards against known defaults; it is not a password-strength check.
FINSIGHT_POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage (non-secret)
# ---------------------------------------------------------------------------
#
# Named for the S3 protocol, not for any vendor: the same variables point at AWS
# S3, Cloudflare R2, or another S3-compatible service without a code change. The
# local backend is SeaweedFS, which serves S3 on port 8333.
#
# The same two credential variables are used to generate the object store's
# identities file, so there is one source of truth. See README.
#
# Leave FINSIGHT_S3_ENDPOINT_URL unset to use the SDK default, which is how an
# AWS deployment works. A non-loopback endpoint must use https, or startup fails.

FINSIGHT_S3_ENDPOINT_URL=http://127.0.0.1:8333
FINSIGHT_S3_BUCKET=finsight
FINSIGHT_S3_REGION=us-east-1

# path for self-hosted backends; virtual or auto for AWS
FINSIGHT_S3_ADDRESSING_STYLE=path

# Leave both credential variables unset in a cloud deployment to fall through to
# the default credential chain (instance role, workload identity).
FINSIGHT_S3_ACCESS_KEY_ID=finsight

# ---------------------------------------------------------------------------
# Object storage credential (secret)
# ---------------------------------------------------------------------------
#
# Required locally: the object store enforces it through its identities file.
# Rejected when empty or when it matches a known default such as minioadmin.
FINSIGHT_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Embedding (optional; the model is PROVISIONAL, not selected)
# ---------------------------------------------------------------------------
#
# Ollama runs host-native, not in Compose, so this is an endpoint on the host
# rather than a service name. The model is adopted provisionally by ADR-004 as
# PROJECT_BLUEPRINT.md §22.2's named initial candidate; §22.10 reserves selection
# for the smallest model with acceptable measured quality.
#
# Dimensions must move with the model: a collection is created with a fixed
# width, and the adapter verifies the response rather than trusting it.

# FINSIGHT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# FINSIGHT_EMBEDDING_MODEL=nomic-embed-text
# FINSIGHT_EMBEDDING_DIMENSIONS=768
# FINSIGHT_EMBEDDING_TIMEOUT_SECONDS=120
# FINSIGHT_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Vector index (optional)
# ---------------------------------------------------------------------------
#
# Qdrant is derived and rebuildable from PostgreSQL (§29.2), so losing it costs
# time rather than evidence, and readiness treats it as degradable: dense
# retrieval falls back to the lexical path with a flag (§20.12).
#
# The collection name is NOT configurable. It is derived from the embedding model
# and width, so changing the model targets a different collection automatically
# rather than mixing two vector spaces in one.

# FINSIGHT_QDRANT_URL=http://127.0.0.1:6333
# FINSIGHT_QDRANT_TIMEOUT_SECONDS=30
# FINSIGHT_EMBEDDING_CONFIG_VERSION=1

# FINSIGHT_QDRANT_PORT was listed here and has been removed, because it was a trap
# rather than a setting. It is not a field on Settings, and while an unknown
# FINSIGHT_* *environment variable* is ignored, an unknown key in this file is
# rejected: pydantic-settings raises extra_forbidden and the application will not
# start. Uncommenting it therefore broke the whole application instead of changing a
# port. Host port mappings now live in the PUBLISH_* namespace below.

# ---------------------------------------------------------------------------
# Host port mappings (Compose only; never read by the application)
# ---------------------------------------------------------------------------
#
# Deliberately not FINSIGHT_*, for the reason above: these are deployment concerns
# that Compose interpolates, and a FINSIGHT_ name here would be a crash waiting for
# someone to need an override.
#
# Everything binds 127.0.0.1, so none of it is reachable from the local network.
# The 87xx block is reserved for the application tier and chosen to avoid both the
# usual defaults (8000, 8080, 8501) and other projects on this host.

# PUBLISH_API_PORT=8701
# PUBLISH_UI_PORT=8702
# PUBLISH_QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# Lexical retrieval (optional; NOT a selected value)
# ---------------------------------------------------------------------------
#
# The PostgreSQL text-search configuration used to analyse chunk text and
# queries. PROJECT_BLUEPRINT.md §9.7 requires this to be chosen with recorded
# evidence when the lexical index is built, not assumed. The corpus is
# India-first with non-Indian supplements, so one hardcoded language is not a
# safe default.
#
# Changing it requires re-chunking under a new generation: stored lexemes were
# analysed with the previous configuration and would not match new queries.

# FINSIGHT_TEXT_SEARCH_CONFIG=english

# ---------------------------------------------------------------------------
# Upload limits (optional; safe operational bounds shown)
# ---------------------------------------------------------------------------

# FINSIGHT_UPLOAD_MAX_BYTES=268435456
# FINSIGHT_ALLOWED_CONTENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/html,application/xml,text/xml

# ---------------------------------------------------------------------------
# Object-storage transfer tuning (optional; unmeasured initial defaults shown)
# ---------------------------------------------------------------------------
#
# botocore defaults to 60 s for both timeouts, which is far too long for an
# ingestion path. Worst case is attempts x (connect + read).

# FINSIGHT_S3_CONNECT_TIMEOUT_SECONDS=5
# FINSIGHT_S3_READ_TIMEOUT_SECONDS=30
# FINSIGHT_S3_MAX_ATTEMPTS=3
# FINSIGHT_S3_MULTIPART_THRESHOLD_BYTES=67108864
# FINSIGHT_S3_MULTIPART_CONCURRENCY=2

# Record a SHA-256 checksum on write. Verified working on the pinned backend;
# set to false only for a backend that rejects the header.
# FINSIGHT_S3_SEND_CHECKSUM=true

# ---------------------------------------------------------------------------
# Connection pool (optional; initial operational defaults shown)
# ---------------------------------------------------------------------------
#
# These values are NOT measured or tuned. They are starting points chosen from
# safe operational constraints and must be measured under the complete stack
# before any of them is treated as a validated setting. Uncomment to override.

# FINSIGHT_DB_POOL_SIZE=5
# FINSIGHT_DB_MAX_OVERFLOW=5
# FINSIGHT_DB_POOL_RECYCLE_SECONDS=1800
# FINSIGHT_DB_CONNECT_TIMEOUT_SECONDS=5
